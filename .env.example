# 复制为 .env 并在本地填真实值；.env 已被 .gitignore 忽略，绝不提交真实密钥
#
# 换模型 / 换厂商：改下面三个 LLM_* 变量即可（任何 OpenAI 兼容的 /chat/completions 都能用）
#   LLM_BASE_URL=https://api.deepseek.com          ← DeepSeek 官方
#   LLM_BASE_URL=https://api.openai.com/v1         ← OpenAI
#   LLM_BASE_URL=http://localhost:11434/v1         ← 本地 Ollama
# 也兼容旧变量名 DEEPSEEK_*（两者同时存在时以 LLM_* 为准）
#
# 注意：模型必须支持 JSON 输出（代码用 response_format=json_object）。
# 思考型模型（*-pro / *-reasoner）会占用输出配额，max_tokens 偏小会返回空内容；
# 程序会自动加倍 max_tokens 重试一次，仍失败会明确报错，不会静默降级。

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 思考模式：auto（DeepSeek 自动关闭）/ enabled / disabled
# DeepSeek 官方默认 enabled，会让思考过程吃掉 max_tokens 导致返回空内容，本项目默认关闭
LLM_THINKING=auto

# 对外部署开关（重要）：
#   0 或空 = 本机自用。网页上没填 key 时，回退用 .env 里这把 key（方便你自己）
#   1      = 只允许访客用他自己的 key。没带 key 的请求直接 400，服务器上的 key 绝不代跑
# 想让别人用、又不想替别人付钱，部署时必须设成 1
BYOK_ONLY=0

# 每人每天最多"真实调用模型"多少次（缓存命中不算），0 或留空 = 不限制
# 一次岗位分析大约 3-4 次调用，所以 30 约等于每天 7-10 个岗位
# 超了以后网页会直接提示"今天已经用了 N 次，明天再来"，不会再扣你的钱
DAILY_LIMIT=30

# ---- 兼容旧名（可留空，留空时用上面的 LLM_*）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# 飞书多维表格（暂不填）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
